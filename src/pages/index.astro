---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leap</title>
    <meta
      name="description"
      content="A small browser game: hold to charge a jump, release to leap to the next platform."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">Leap</h1>
      <canvas id="game" aria-label="Jumping game"></canvas>
      <div id="score" aria-hidden="true">0</div>
      <div id="difficulty" role="group" aria-label="Difficulty">
        <button type="button" class="difficulty-btn" data-mode="easy" aria-pressed="true">Easy</button>
        <button type="button" class="difficulty-btn" data-mode="medium" aria-pressed="false">Medium</button>
        <button type="button" class="difficulty-btn" data-mode="hard" aria-pressed="false">Hard</button>
      </div>
      <div id="overlay" hidden>
        <p id="overlay-message"></p>
        <button id="restart" type="button">Restart</button>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
